{% doc %}
  Every message on a ticket, oldest first, which is the order the timeline
  is drawn in.

  @param {string} ticket_id - The ticket record ID
{% enddoc %}
{% liquid
  if ticket_id == blank
    return nil
  endif

  graphql result = 'modules/support/messages/search', body: null, ticket_id: ticket_id, contact_id: null, created_at_gte: null, message_id_header: null, message_id_headers: null, id: null, limit: 200, page: 1
  return result.records.results
%}
