{% doc %}
  The working set the ticket list is drawn from: every open ticket the
  viewer is allowed to see, in rank order.

  One query, not seventeen. Every count in the sidebar, every tab and every
  filter is then computed from this array in Liquid. Counting in the
  database would mean a query per status, per department, per view and per
  priority on every page load.

  The cap is deliberate. A support queue that has run past it has a
  different problem than pagination, and the number is visible rather than
  silently truncating one group.

  @param {object} agent - The viewing agent; admins see every department
  @param {array} statuses - Every status, to work out which ones are open
  @param {number} [limit] - Defaults to 500
{% enddoc %}
{% liquid
  assign limit = limit | default: 500

  assign open_status_ids = []
  for status in statuses
    unless status.kind == 'closed'
      assign open_status_ids = open_status_ids | array_add: status.id
    endunless
  endfor

  assign department_ids = null
  unless agent.role == 'admin'
    assign department_ids = agent.department_ids
  endunless

  assign sort = { "properties": { "name": "rank", "order": "ASC" } }
  graphql result = 'modules/support/tickets/search', status_ids: open_status_ids, department_ids: department_ids, sort: sort, limit: limit, page: 1, id: null, number: null, department_id: null, status_id: null, contact_id: null, assignee_id: null, priority: null, query: null

  return result.records.results
%}
