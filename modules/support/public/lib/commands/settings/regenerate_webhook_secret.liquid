{% doc %}
  Issues a new inbound secret.

  Inbound mail stops working the moment this runs, until the new secret is
  saved at the provider, which is why the Settings screen warns before
  offering it.
{% enddoc %}
{% liquid
  function settings = 'modules/support/queries/settings/get'
  if settings == blank
    log 'ERROR: no settings record in modules/support/commands/settings/regenerate_webhook_secret'
    return nil
  endif

  assign secret = 32 | random_string
  graphql _ = 'modules/support/settings/set_webhook_secret', id: settings.id, webhook_secret: secret

  return secret
%}
