{% doc %}
  Records something that happened to a ticket. actor_id is blank when the
  customer caused it, as a reply to a closed ticket does.

  @param {string} ticket_id - The ticket
  @param {string} action - status_changed, priority_changed, assigned, reranked or reopened
  @param {string} [actor_id] - The agent's user id
  @param {string} [from_value] - Previous value, for display
  @param {string} [to_value] - New value, for display
{% enddoc %}
{% liquid
  if ticket_id == blank or action == blank
    log 'ERROR: missing ticket_id or action in modules/support/commands/activities/log'
    return nil
  endif

  graphql created = 'modules/support/activities/create', ticket_id: ticket_id, actor_id: actor_id, action: action, from_value: from_value, to_value: to_value
  return created.record
%}
