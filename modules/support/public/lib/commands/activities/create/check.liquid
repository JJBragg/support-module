{% doc %}
  @param {object} object - The built input
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  assign actions = 'status_changed,priority_changed,assigned,reranked,reopened' | split: ','

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'ticket_id', key: null
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'action', key: null

  if object.action != blank
    function c = 'modules/core/validations/included', c: c, object: object, field_name: 'action', array: actions, value: null, key: 'modules/support/validation.action'
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
