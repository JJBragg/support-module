{% doc %}
  Adds one item to a ticket's timeline: an inbound email, an outbound email
  or a private note.

  @param {object} object - ticket_id and kind, plus the message fields
{% enddoc %}
{% liquid
  function object = 'modules/support/commands/messages/create/build', object: object
  function object = 'modules/support/commands/messages/create/check', object: object

  if object.valid
    function object = 'modules/core/commands/execute', mutation_name: 'modules/support/messages/create', object: object, selection: null
  endif

  return object
%}
