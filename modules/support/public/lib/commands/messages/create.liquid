{% doc %}
  Adds one item to a ticket's timeline: an inbound email, an outbound email
  or a private note.

  @param {string} ticket_id - The ticket
  @param {string} kind - inbound, outbound or note
  @param {string} [contact_id] - Author, for inbound
  @param {string} [user_id] - Author, for outbound and notes
  @param {string} [from_address] - The From header
  @param {array} [to_addresses] - The To header
  @param {array} [cc_addresses] - The Cc header
  @param {string} [subject] - The subject line
  @param {string} [body_html] - The new content, HTML
  @param {string} [body_text] - The new content, plain text
  @param {string} [quoted_html] - The quoted history
  @param {string} [message_id_header] - This message's own Message-ID
  @param {string} [in_reply_to] - The Message-ID this answers
  @param {array} [references] - The thread's Message-ID chain
  @param {string} [provider_message_id] - Set on send, for outbound
  @param {string} [delivery_status] - Set on send, for outbound
{% enddoc %}
{% liquid
  if ticket_id == blank or kind == blank
    log 'ERROR: missing ticket_id or kind in modules/support/commands/messages/create'
    return nil
  endif

  graphql created = 'modules/support/messages/create', ticket_id: ticket_id, kind: kind, contact_id: contact_id, user_id: user_id, from_address: from_address, to_addresses: to_addresses, cc_addresses: cc_addresses, subject: subject, body_html: body_html, body_text: body_text, quoted_html: quoted_html, message_id_header: message_id_header, in_reply_to: in_reply_to, references: references, provider_message_id: provider_message_id, delivery_status: delivery_status

  return created.record
%}
