{% doc %}
  @param {object} object - The built input
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  assign kinds = 'inbound,outbound,note' | split: ','

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'ticket_id', key: null
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'kind', key: null

  if object.kind != blank
    comment
      The kind decides whether the timeline draws this as an email or as a
      private note, and a note that is mistaken for an email is the worst
      thing this module could do.
    endcomment
    function c = 'modules/core/validations/included', c: c, object: object, field_name: 'kind', array: kinds, value: null, key: 'modules/support/validation.kind'
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
