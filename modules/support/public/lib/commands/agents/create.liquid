{% doc %}
  Gives a platformOS user access to the support queue. Returns the existing
  agent untouched if there is one, so this is safe to call from a seed or an
  invite that was accepted twice.

  @param {object} object - user_id, role, and optionally department_ids and title
{% enddoc %}
{% liquid
  function existing = 'modules/support/queries/agents/find', user_id: object.user_id, id: null
  if existing
    assign existing.valid = true
    return existing
  endif

  function object = 'modules/support/commands/agents/create/build', object: object
  function object = 'modules/support/commands/agents/create/check', object: object

  if object.valid
    function object = 'modules/core/commands/execute', mutation_name: 'modules/support/agents/create', object: object, selection: null
  endif

  return object
%}
