{% doc %}
  @param {object} object - The built input
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  assign roles = 'admin,agent' | split: ','

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'user_id', key: null
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'role', key: null

  if object.role != blank
    function c = 'modules/core/validations/included', c: c, object: object, field_name: 'role', array: roles, value: null, key: 'modules/support/validation.role'
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
