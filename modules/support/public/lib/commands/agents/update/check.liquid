{% doc %}
  @param {object} object - The built input
  @param {object} agent - The existing record
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  assign roles = 'admin,agent' | split: ','

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'role', key: null
  function c = 'modules/core/validations/included', c: c, object: object, field_name: 'role', array: roles, value: null, key: 'modules/support/validation.role'

  comment
    Settings is the only place an admin is made, so an install with no
    admins left has no way back in except a host superadmin. That is the
    break glass path in helpers/can, not something to rely on.
  endcomment
  if agent.role == 'admin' and object.role != 'admin'
    graphql admins = 'modules/support/agents/search', role: 'admin', limit: 2, page: 1, id: null, ids: null, user_id: null
    if admins.records.total_entries < 2
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'role', key: 'modules/support/validation.last_admin', message: null
    endif
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
