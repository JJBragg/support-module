{% doc %}
  @param {object} object - The built input
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'value', key: null

  comment
    A domain with no dot in it is a typo, and a typo in a blocklist is
    mail silently going missing. Addresses are not checked any harder
    than this: the only one that ever reaches here is one a customer
    actually sent from.
  endcomment
  if object.scope == 'domain' and object.value != blank
    unless object.value contains '.'
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'value', key: 'modules/support/validation.blocked_value', message: null
    endunless
  endif

  comment
    Blocking the same thing twice is not an error worth stopping for,
    but it should not make a second row either.
  endcomment
  if object.value != blank
    function existing = 'modules/support/queries/blocked_senders/find_match', email: object.value
    if existing and existing.value == object.value
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'value', key: 'modules/support/validation.blocked_duplicate', message: null
    endif
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
