{% doc %}
  @param {object} object - The built input
  @param {object} status - The existing record, for the two jobs a status
    can be holding that its kind has to stay compatible with
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  assign kinds = 'new,open,pending,on_hold,solved,closed' | split: ','

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'name', key: null
  function c = 'modules/core/validations/included', c: c, object: object, field_name: 'kind', array: kinds, value: null, key: 'modules/support/validation.status_kind'

  comment
    Two statuses carry a job as well as a label, and both jobs put a live
    ticket into that status. Finishing either one strands the thing it is
    for: inbound mail would open tickets straight into a finished status,
    or a customer reply would reopen a ticket into one.
  endcomment
  assign finished = 'solved,closed' | split: ','
  if finished contains object.kind
    if status.is_new_default
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'kind', key: 'modules/support/validation.status_is_new_default', message: null
    endif
    if status.is_reopen_target
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'kind', key: 'modules/support/validation.status_is_reopen_target', message: null
    endif
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
