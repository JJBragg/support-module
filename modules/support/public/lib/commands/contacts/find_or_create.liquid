{% doc %}
  A customer is only ever identified by their email address, so this is a
  lookup on email with a create behind it. An existing contact is returned
  untouched: a display name from one client's From header is not a reason
  to overwrite a name an agent may have corrected.

  @param {string} [email] - The sender address
  @param {string} [name] - The display name from the From header
  @param {string} [organization] - Known only when an agent fills it in
{% enddoc %}
{% liquid
  assign email = email | default: '' | strip | downcase

  function existing = 'modules/support/queries/contacts/find_by_email', email: email
  if existing
    assign existing.valid = true
    return existing
  endif

  assign input = { "email": email, "name": name, "organization": organization }
  function created = 'modules/support/commands/contacts/create', object: input
  return created
%}
