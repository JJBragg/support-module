{% doc %}
  A ticket list URL with some filters changed and the rest kept.

  Every filter lives in the query string rather than in a session, so a
  view can be linked to, opened in a second tab and shared with the agent
  sitting next to you. Pass an empty string to drop a filter.

  @param {object} overrides - Filters to change
{% enddoc %}
{% liquid
  assign keys = 'view,status,department,priority,group,q,assignee,contact,expand,collapsed' | split: ','
  assign parts = []

  for key in keys
    assign value = context.params[key]
    if overrides[key] != null
      assign value = overrides[key]
    endif

    if value != blank
      assign encoded = value | url_encode
      assign part = key | append: '=' | append: encoded
      assign parts = parts | array_add: part
    endif
  endfor

  if parts == empty
    return '/support'
  endif

  assign query = parts | join: '&'
  assign url = '/support?' | append: query
  return url
%}
