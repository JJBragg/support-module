{% doc %}
  The fixed visual vocabulary: status colours and icons, priority colours,
  and the palettes departments and agents are coloured from.

  None of this is themed. A partner recolours the interface through the
  four theme variables, but Under Review has to look like Under Review on
  every site, or a support team that works across two of them has to learn
  the colours twice. Every colour is paired with an icon, a letter or a P
  number, so colour is never the only carrier.

  Departments and agents are coloured by position rather than by name,
  since a partner's departments are not ours.
{% enddoc %}
{% liquid
  assign statuses = {
    "new": { "icon": "M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.5 2.5M15.2 15.2l2.5 2.5M6.3 17.7l2.5-2.5M15.2 8.8l2.5-2.5", "bg": "#EEF0FF", "fg": "#3730A3" },
    "under_review": { "icon": "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z", "bg": "#E3F1FB", "fg": "#075985" },
    "in_progress": { "icon": "M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0zM10 8.5l5 3.5-5 3.5z", "bg": "#FBE7F1", "fg": "#8E1D57" },
    "waiting_customer": { "icon": "M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0zM12 7v5l3 2", "bg": "#EFF0F2", "fg": "#374151" },
    "waiting_deploy": { "icon": "M12 16V4M6 10l6-6 6 6M4 20h16", "bg": "#F2EEFF", "fg": "#5B21B6" },
    "confirmation": { "icon": "M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0zM8 12l3 3 5-6", "bg": "#E6F5EC", "fg": "#065F46" },
    "on_hold": { "icon": "M9 5v14M15 5v14", "bg": "#FDF1D3", "fg": "#92400E" },
    "closed": { "icon": "M5 12l5 5 9-11", "bg": "#EFF0F2", "fg": "#4B5563" }
  }

  comment
    A status a partner adds has no entry above, so it falls back to this
    one rather than rendering colourless.
  endcomment
  assign status_fallback = { "icon": "M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0z", "bg": "#EFF0F2", "fg": "#374151" }

  comment
    Translated here, assigned first because a filter inside a JSON literal
    is a parse error. The P numbers are not translated: they are the thing
    agents say out loud, and a P0 is a P0 in every language.
  endcomment
  assign critical = 'modules/support/list.priority.critical' | t
  assign high = 'modules/support/list.priority.high' | t
  assign normal = 'modules/support/list.priority.normal' | t
  assign low = 'modules/support/list.priority.low' | t

  assign priorities = [
    { "key": "P0", "label": critical, "bg": "#9B1C24", "fg": "#FFFFFF", "bd": "#9B1C24" },
    { "key": "P1", "label": high, "bg": "#FDE8D7", "fg": "#8A3207", "bd": "#E9A877" },
    { "key": "P2", "label": normal, "bg": "#E8EEF8", "fg": "#25427A", "bd": "#B9C8E3" },
    { "key": "P3", "label": low, "bg": "#F1F2F4", "fg": "#4B5563", "bd": "#D3D6DB" }
  ]

  assign department_palette = [
