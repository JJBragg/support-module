    { "bg": "#E4F4F1", "fg": "#0B5D52", "bd": "#B5DDD5" },
    { "bg": "#F1ECFB", "fg": "#5B2E9E", "bd": "#D6C8F0" },
    { "bg": "#FBECEC", "fg": "#8A2222", "bd": "#EFC7C7" },
