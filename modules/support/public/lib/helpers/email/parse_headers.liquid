{% doc %}
  Pulls the headers the module reads out of the raw block SendGrid posts:
  Message-ID, In-Reply-To and References for threading, and the four that
  say an email was sent by a machine rather than a person. Folded headers,
  where References continues on indented lines, are joined back together
  before they are read.

  Returns ids without angle brackets, which is how message_id_header is
  stored.

  @param {string} [raw] - The raw headers field
{% enddoc %}
{% capture nl %}
{% endcapture %}
{% liquid
  assign message_id = ""
  assign in_reply_to = ""
  assign references = []
  assign auto_submitted = ""
  assign precedence = ""
  assign return_path = ""
  assign list_id = ""

  assign raw = raw | default: ""
  if raw == blank
    comment
      No headers at all is itself suspicious, but it is not this helper's
      job to say so. It reports what it found, and found nothing.
    endcomment
    assign parsed = { "message_id": message_id, "in_reply_to": in_reply_to, "references": references, "auto_submitted": auto_submitted, "precedence": precedence, "return_path": return_path, "list_id": list_id, "present": false }
    return parsed
  endif

  assign lines = raw | split: nl
  assign current_key = ""
  assign current_value = ""
  assign unfolded = []

  for line in lines
    assign without_indent = line | lstrip

    if without_indent != line and current_key != blank
      assign current_value = current_value | append: " " | append: without_indent
    else
      if current_key != blank
        assign entry = { "key": current_key, "value": current_value }
        assign unfolded = unfolded | array_add: entry
      endif
      assign raw_key = line | split: ":" | first
      assign current_key = raw_key | strip | downcase
      assign current_value = line | remove_first: raw_key | remove_first: ":" | strip
    endif
  endfor

  if current_key != blank
    assign entry = { "key": current_key, "value": current_value }
    assign unfolded = unfolded | array_add: entry
  endif

  for header in unfolded
    if header.key == "message-id" and message_id == blank
      assign message_id = header.value | replace: "<", "" | replace: ">", "" | strip
    elsif header.key == "in-reply-to" and in_reply_to == blank
      assign in_reply_to = header.value | replace: "<", "" | replace: ">", "" | strip
    elsif header.key == "references"
      assign tokens = header.value | split: " "
      for token in tokens
        assign id = token | replace: "<", "" | replace: ">", "" | strip
        if id != blank
          assign references = references | array_add: id
        endif
      endfor
    elsif header.key == "auto-submitted" and auto_submitted == blank
      assign auto_submitted = header.value | downcase | strip
    elsif header.key == "precedence" and precedence == blank
      assign precedence = header.value | downcase | strip
    elsif header.key == "return-path" and return_path == blank
      assign return_path = header.value | replace: "<", "" | replace: ">", "" | strip
    elsif header.key == "list-id" and list_id == blank
      assign list_id = header.value | strip
    endif
  endfor

  assign parsed = { "message_id": message_id, "in_reply_to": in_reply_to, "references": references, "auto_submitted": auto_submitted, "precedence": precedence, "return_path": return_path, "list_id": list_id, "present": true }
  return parsed
%}
