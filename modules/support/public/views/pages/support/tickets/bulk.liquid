---
slug: support/tickets/bulk
method: post
---
{%- comment -%}
  Applies one change to every selected ticket. Each field is optional, so
  the same form assigns, reprioritises or moves status depending on which
  select was touched.

  A priority change sends the ticket to the top of its new priority, which
  is what the detail screen does too, and is a placement rather than a
  reordering of anyone else's work.
{%- endcomment -%}
{%- liquid
  # platformos-check-disable DeprecatedTag
  include 'modules/support/helpers/require_permission', do: 'support.tickets.update', entity: null
  # platformos-check-enable DeprecatedTag

  function current_profile = 'modules/user/helpers/current_profile'
  function statuses = 'modules/support/queries/statuses/search', kind: null

  assign return_to = context.params.return_to | default: '/support'
  assign ticket_ids = context.params.ticket_ids

  assign assignee_id = context.params.assignee_id
  assign status_id = context.params.status_id
  assign priority = context.params.priority

  assign changed = 0
  for ticket_id in ticket_ids
    # platformos-check-disable NestedGraphQLQuery
    function ticket = 'modules/support/queries/tickets/find', id: ticket_id, number: null
    # platformos-check-enable NestedGraphQLQuery

    if ticket == blank
      continue
    endif

    if assignee_id != blank
      assign new_assignee = assignee_id
      if assignee_id == 'none'
        assign new_assignee = null
      endif
      # platformos-check-disable NestedGraphQLQuery
      graphql _ = 'modules/support/tickets/set_assignee', id: ticket.id, assignee_id: new_assignee
      # platformos-check-enable NestedGraphQLQuery
      assign activity = { "ticket_id": ticket.id, "actor_id": current_profile.user.id, "action": "assigned", "from_value": ticket.assignee_id, "to_value": new_assignee }
      function _ = 'modules/support/commands/activities/create', object: activity

      assign assigned_payload = { "ticket_id": ticket.id, "assignee_id": new_assignee, "actor_id": current_profile.user.id }
      # platformos-check-disable NestedGraphQLQuery
      function _ = 'modules/core/commands/events/publish', type: 'ticket_assigned', object: assigned_payload, delay: null, max_attempts: null
      # platformos-check-enable NestedGraphQLQuery
    endif

    if status_id != blank
      assign target = null
      for status in statuses
        if status.id == status_id
          assign target = status
        endif
      endfor
      function stamps = 'modules/support/helpers/status/stamps', status: target
      # platformos-check-disable NestedGraphQLQuery
      graphql _ = 'modules/support/tickets/set_status', id: ticket.id, status_id: status_id, closed_at: stamps.closed_at, solved_at: stamps.solved_at
      # platformos-check-enable NestedGraphQLQuery
      assign activity = { "ticket_id": ticket.id, "actor_id": current_profile.user.id, "action": "status_changed", "from_value": ticket.status_id, "to_value": status_id }
      function _ = 'modules/support/commands/activities/create', object: activity
    endif

    if priority != blank
      function _ = 'modules/support/commands/tickets/rerank', ticket: ticket, statuses: statuses, priority: priority, before_id: null, direction: null, actor_id: current_profile.user.id
    endif

    assign changed = changed | plus: 1
  endfor

  assign notice = 'modules/support/list.bulk.updated_other' | t: count: changed
  if changed == 1
    assign notice = 'modules/support/list.bulk.updated_one' | t
  endif
  function _ = 'modules/support/helpers/flash', message: notice, severity: 'success'

  # platformos-check-disable DeprecatedTag
  include 'modules/support/helpers/redirect_back', url: return_to
  # platformos-check-enable DeprecatedTag
-%}
