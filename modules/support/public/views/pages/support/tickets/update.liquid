---
slug: support/tickets/update
method: post
---
{%- comment -%}
  One endpoint for the properties panel. Each control is its own small
  form posting here, so every one of them works without JavaScript; the
  script only removes the Apply buttons and submits on change.

  Priority is not handled as a plain field. Changing it places the ticket
  at the top of its new priority, which is what the designs promise and
  what an agent escalating something expects, so it goes through the same
  rerank command drag and drop uses.
{%- endcomment -%}
{%- liquid
  function current_profile = 'modules/user/helpers/current_profile'
  function statuses = 'modules/support/queries/statuses/search', kind: null
  function ticket = 'modules/support/queries/tickets/find', id: context.params.ticket_id, number: null

  assign return_to = context.params.return_to | default: '/support'

  if ticket == blank
    # platformos-check-disable DeprecatedTag
    include 'modules/support/helpers/redirect_back', url: return_to
    # platformos-check-enable DeprecatedTag
  endif

  # platformos-check-disable DeprecatedTag
  include 'modules/support/helpers/require_permission', do: 'support.tickets.update', entity: ticket
  # platformos-check-enable DeprecatedTag

  assign actor_id = current_profile.user.id

  if context.params.status_id != blank and context.params.status_id != ticket.status_id
    assign closed_at = null
    assign previous_name = ''
    assign new_name = ''
    for status in statuses
      if status.id == ticket.status_id
        assign previous_name = status.name
      endif
      if status.id == context.params.status_id
        assign new_name = status.name
        if status.kind == 'closed'
          assign closed_at = 'now' | date: '%Y-%m-%d %H:%M:%S'
        endif
      endif
    endfor

    graphql _ = 'modules/support/tickets/set_status', id: ticket.id, status_id: context.params.status_id, closed_at: closed_at
    assign activity = { "ticket_id": ticket.id, "actor_id": actor_id, "action": "status_changed", "from_value": previous_name, "to_value": new_name }
    function _ = 'modules/support/commands/activities/create', object: activity
  endif

  if context.params.assignee_id != blank
    assign new_assignee = context.params.assignee_id
    if new_assignee == 'none'
      assign new_assignee = null
    endif

    unless new_assignee == ticket.assignee_id
      graphql _ = 'modules/support/tickets/set_assignee', id: ticket.id, assignee_id: new_assignee
      assign activity = { "ticket_id": ticket.id, "actor_id": actor_id, "action": "assigned", "from_value": ticket.assignee_id, "to_value": new_assignee }
      function _ = 'modules/support/commands/activities/create', object: activity

      assign assigned_payload = { "ticket_id": ticket.id, "assignee_id": new_assignee, "actor_id": actor_id }
      function _ = 'modules/core/commands/events/publish', type: 'ticket_assigned', object: assigned_payload, delay: null, max_attempts: null
    endunless
  endif

  if context.params.department_id != blank and context.params.department_id != ticket.department_id
    graphql _ = 'modules/support/tickets/set_department', id: ticket.id, department_id: context.params.department_id
  endif

  if context.params.priority != blank
    assign new_priority = context.params.priority | plus: 0
    unless new_priority == ticket.priority
      function _ = 'modules/support/commands/tickets/rerank', ticket: ticket, statuses: statuses, priority: new_priority, before_id: null, direction: null, actor_id: actor_id
    endunless
  endif

  # platformos-check-disable DeprecatedTag
  include 'modules/support/helpers/redirect_back', url: return_to
  # platformos-check-enable DeprecatedTag
-%}
