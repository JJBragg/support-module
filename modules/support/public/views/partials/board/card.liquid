{%- comment -%}
  One ticket on the board.

  The place in line rides on the priority tag, because a status column
  mixes priorities and the number on its own would read as a position in
  the column, which it is not. A closed ticket has no place in line: it is
  out of the work order, so the tag shows the priority alone.

  Every card carries a Move to menu as well as being draggable. The menu
  is the whole feature for anyone working by keyboard, and it is the only
  way the board works with JavaScript off, so it is a real form posting to
  the same endpoint drag and drop uses.

  @param {object} row - The ticket, already stitched
  @param {array} statuses - Every status, for the Move to menu
  @param {string} return_to - Where the move posts back to
  @param {boolean} can_update - Whether this agent may change the status
{%- endcomment -%}
{%- liquid
  assign draggable = 'false'
  if can_update
    assign draggable = 'true'
  endif

  assign assignee_label = ''
  if row.assignee
    assign assignee_label = 'modules/support/board.card.assigned_to' | t: name: row.assignee.name
  endif
-%}
<li class="pos-support-bcard" data-ticket-id="{{ row.id }}" data-status-id="{{ row.status_id }}" draggable="{{ draggable }}">
  <div class="pos-support-bcard-top">
    {%- if row.place != blank -%}
      <span class="pos-support-bplace" title="{{ 'modules/support/board.card.place_title' | t: key: row.priority_token.key }}">
        <span class="pos-support-bplace-key" style="background: {{ row.priority_token.bg }}; color: {{ row.priority_token.fg }}">{{ row.priority_token.key }}</span>
        <span class="pos-support-bplace-rank">{{ row.place }}</span>
      </span>
    {%- else -%}
      {% render 'modules/support/tags/priority', priority: row.priority_token %}
    {%- endif -%}
    <span class="pos-support-bcard-number">#{{ row.number }}</span>
    {%- if row.assignee -%}
      <span class="pos-support-avatar" role="img" aria-label="{{ assignee_label }}" style="background: {{ row.assignee.palette.bg }}; color: {{ row.assignee.palette.fg }}">{{ row.assignee.initials }}</span>
    {%- else -%}
      <span class="pos-support-avatar is-unassigned" role="img" aria-label="{{ 'modules/support/list.row.unassigned' | t }}"></span>
    {%- endif -%}
  </div>

  <a class="pos-support-bcard-subject" href="/admin/support/tickets/{{ row.number }}" title="{{ row.subject }}">{{ row.subject }}</a>

  <div class="pos-support-bcard-foot">
    {% render 'modules/support/tags/department', department: row.department %}
    <span class="pos-support-bcard-contact">{{ row.contact.name | default: row.contact.email }}</span>
  </div>

  {%- if can_update -%}
    <details class="pos-support-cardmove">
      <summary>{{ 'modules/support/board.card.move' | t }}</summary>
      <form method="post" action="/admin/support/board/move">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <input type="hidden" name="ticket_id" value="{{ row.id }}">
        <input type="hidden" name="return_to" value="{{ return_to }}">
        <label class="pos-support-sr" for="pos-support-move-{{ row.id }}">{{ 'modules/support/board.card.move_label' | t: number: row.number }}</label>
        <select id="pos-support-move-{{ row.id }}" name="status_id">
          {%- for status in statuses -%}
            <option value="{{ status.id }}" {% if status.id == row.status_id %}selected{% endif %}>{{ status.name }}</option>
          {%- endfor -%}
        </select>
        <button type="submit">{{ 'modules/support/board.card.move_submit' | t }}</button>
      </form>
    </details>
  {%- endif -%}
</li>
