{%- comment -%}
  The list's toolbar: priority tabs, the assignee filter and the grouping
  switch. The first two are shared with the board.
{%- endcomment -%}
{%- liquid
  function url_group_priority = 'modules/support/helpers/ui/queue_url', overrides: { "group": "", "expand": "", "collapsed": "" }
  function url_group_status = 'modules/support/helpers/ui/queue_url', overrides: { "group": "status", "expand": "", "collapsed": "" }

  assign grouping_by_priority = false
  if group_by != 'status'
    assign grouping_by_priority = true
  endif

  assign carried = 'view,status,department,priority,group,q' | split: ','
-%}
<div class="pos-support-toolbar">
  {% render 'modules/support/ui/priority_tabs',
    tokens: tokens,
    priority_counts: priority_counts,
    priority_filter: priority_filter,
    priority_total: priority_total
  %}

  <span class="pos-support-divider" aria-hidden="true"></span>

  {% render 'modules/support/ui/assignee_filter',
    all_agents: all_agents,
    assignee_filter: assignee_filter,
    base: '/support',
    carried: carried
  %}

  <div class="pos-support-segment" role="group" aria-label="{{ 'modules/support/list.toolbar.group_by' | t }}" style="margin-left: auto">
    <span class="pos-support-toolbar-label">{{ 'modules/support/list.toolbar.group_by' | t }}</span>
    <a class="pos-support-navitem" style="height: 28px; width: auto" href="{{ url_group_priority }}" aria-pressed="{{ grouping_by_priority }}">{{ 'modules/support/list.toolbar.group_by_priority' | t }}</a>
    <a class="pos-support-navitem" style="height: 28px; width: auto" href="{{ url_group_status }}" aria-pressed="{% if group_by == 'status' %}true{% else %}false{% endif %}">{{ 'modules/support/list.toolbar.group_by_status' | t }}</a>
  </div>
</div>
{%- if can_rerank and grouping_by_priority -%}
  <p class="pos-support-hint">
    {% render 'modules/support/ui/icon', path: tokens.icons.drag, size: 14, stroke: 2 %}
    {{ 'modules/support/list.toolbar.drag_hint' | t }}
  </p>
{%- endif -%}
