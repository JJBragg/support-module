<section class="pos-support-section" id="statuses" aria-labelledby="pos-support-h-st">
  <div class="pos-support-section-head">
    <div>
      <h2 id="pos-support-h-st">{{ 'modules/support/settings.statuses.heading' | t }}</h2>
      <span>{{ 'modules/support/settings.statuses.subtitle' | t }}</span>
    </div>
    <a class="pos-support-ghost-button" href="#add-status">
      {% render 'modules/support/ui/icon', path: 'M12 5v14M5 12h14', size: 13, stroke: 2.4 %}
      {{ 'modules/support/settings.statuses.add' | t }}
    </a>
  </div>

  {%- liquid
    assign kinds = 'new,open,pending,on_hold,solved,closed' | split: ','
    assign kind_new = 'modules/support/settings.statuses.kind_new' | t
    assign kind_open = 'modules/support/settings.statuses.kind_open' | t
    assign kind_pending = 'modules/support/settings.statuses.kind_pending' | t
    assign kind_on_hold = 'modules/support/settings.statuses.kind_on_hold' | t
    assign kind_solved = 'modules/support/settings.statuses.kind_solved' | t
    assign kind_closed = 'modules/support/settings.statuses.kind_closed' | t
    assign kind_labels = { "new": kind_new, "open": kind_open, "pending": kind_pending, "on_hold": kind_on_hold, "solved": kind_solved, "closed": kind_closed }
    assign last_index = statuses | size | minus: 1
  -%}

  <div class="pos-support-srowhead pos-support-srow-status" aria-hidden="true">
    <span>{{ 'modules/support/settings.statuses.order' | t }}</span>
    <span>{{ 'modules/support/settings.statuses.name' | t }}</span>
    <span>{{ 'modules/support/settings.statuses.kind' | t }}</span>
  </div>

  <ul class="pos-support-rows">
    {%- for status in statuses -%}
      <li>
        <div class="pos-support-srow pos-support-srow-status">
          <span class="pos-support-sorder">
            <span class="pos-support-sorder-number">{{ forloop.index }}</span>
            <span class="pos-support-sorder-moves">
              <form method="post" action="/support/settings/statuses">
                <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
                <input type="hidden" name="op" value="reorder">
                <input type="hidden" name="status_id" value="{{ status.id }}">
                <button type="submit" name="direction" value="up" aria-label="{{ 'modules/support/settings.statuses.move_up' | t: name: status.name }}" {% if forloop.first %}disabled{% endif %}>
                  {% render 'modules/support/ui/icon', path: 'M6 15l6-6 6 6', size: 10, stroke: 3 %}
                </button>
                <button type="submit" name="direction" value="down" aria-label="{{ 'modules/support/settings.statuses.move_down' | t: name: status.name }}" {% if forloop.index0 == last_index %}disabled{% endif %}>
                  {% render 'modules/support/ui/icon', path: 'M6 9l6 6 6-6', size: 10, stroke: 3 %}
                </button>
              </form>
            </span>
          </span>

          <form class="pos-support-status-name" method="post" action="/support/settings/statuses">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <input type="hidden" name="op" value="rename">
            <input type="hidden" name="status_id" value="{{ status.id }}">
            <span class="pos-support-status-swatch" aria-hidden="true" style="background: {{ status.token.bg }}; color: {{ status.token.fg }}">
              {% render 'modules/support/ui/icon', path: status.token.icon, size: 12, stroke: 2.4 %}
            </span>
            <label class="pos-support-sr" for="st-name-{{ status.id }}">{{ 'modules/support/settings.statuses.name' | t }}</label>
            <input id="st-name-{{ status.id }}" type="text" name="name" value="{{ status.name }}" required>
            <button type="submit">{{ 'modules/support/settings.rename' | t }}</button>
            {%- liquid
              assign is_new_default_label = 'modules/support/settings.statuses.is_new_default' | t
              assign is_reopen_target_label = 'modules/support/settings.statuses.is_reopen_target' | t
            -%}
            {%- if status.is_new_default -%}
              <span class="pos-support-status-job" title="{{ is_new_default_label }}">{{ is_new_default_label }}</span>
            {%- endif -%}
            {%- if status.is_reopen_target -%}
              <span class="pos-support-status-job" title="{{ is_reopen_target_label }}">{{ is_reopen_target_label }}</span>
            {%- endif -%}
          </form>

          {%- comment -%}
            A select, not the row of buttons this used to be. Six
            categories will not sit in a 250px column, and a row that
            wraps to three lines per status turns the whole screen into a
            wall. The script submits it on change and hides the Apply
            button, which is there for anyone without one.
          {%- endcomment -%}
          <form class="pos-support-kindpick" method="post" action="/support/settings/statuses">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <input type="hidden" name="op" value="kind">
            <input type="hidden" name="status_id" value="{{ status.id }}">
            <input type="hidden" name="name" value="{{ status.name }}">
            <label class="pos-support-sr" for="st-kind-{{ status.id }}">{{ 'modules/support/settings.statuses.kind_for' | t: name: status.name }}</label>
            <select id="st-kind-{{ status.id }}" name="kind" data-support-autosubmit>
              {%- for kind in kinds -%}
                <option value="{{ kind }}" {% if kind == status.kind %}selected{% endif %}>{{ kind_labels[kind] }}</option>
              {%- endfor -%}
            </select>
            <button type="submit" data-support-noscript>{{ 'modules/support/settings.apply' | t }}</button>
          </form>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  <span class="pos-support-hint-text">{{ 'modules/support/settings.statuses.hint' | t }}</span>

  <form class="pos-support-editform pos-support-addform" id="add-status" method="post" action="/support/settings/statuses">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <input type="hidden" name="op" value="create">
    <span class="pos-support-formlegend">{{ 'modules/support/settings.statuses.add' | t }}</span>
    <div class="pos-support-formfield">
      <label for="st-new-name">{{ 'modules/support/settings.statuses.name' | t }}</label>
      <input id="st-new-name" type="text" name="name" required>
    </div>
    <div class="pos-support-formfield">
      <label for="st-new-kind">{{ 'modules/support/settings.statuses.kind' | t }}</label>
      <select id="st-new-kind" name="kind">
        {%- for kind in kinds -%}
          <option value="{{ kind }}">{{ kind_labels[kind] }}</option>
        {%- endfor -%}
      </select>
    </div>
    <div class="pos-support-formfoot">
      <button class="pos-support-primary-button" type="submit">{{ 'modules/support/settings.statuses.add' | t }}</button>
    </div>
  </form>
</section>
