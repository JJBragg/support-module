{%- liquid
  assign size = size | default: 15
  assign width = stroke | default: 2
-%}
<svg class="pos-support-icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ width }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{ path }}"></path></svg>
