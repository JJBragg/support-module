#!/usr/bin/env bash
# Runs the module's Liquid tests against an instance and prints a summary.
#
# The tests run on the platform, not here: they are Liquid partials ending
# in _test, discovered and executed by the tests module at /_tests/run.
# So this deploys first, then asks the instance to run them.
#
# Usage: bin/test [environment]        default: staging
set -euo pipefail

env_name="${1:-staging}"
# .pos has no extension, so it has to be read and parsed rather than required.
url=$(node -e "
  const fs = require('fs');
  const envs = JSON.parse(fs.readFileSync('.pos', 'utf8'));
  const env = envs['${env_name}'];
  if (!env || !env.url) process.exit(1);
  process.stdout.write(env.url.replace(/\/$/, ''));
" 2>/dev/null) || {
  echo "No '${env_name}' in .pos. Add it with: pos-cli env add ${env_name}" >&2
  exit 2
}

# Partial deploy. A full deploy removes everything the instance has that this
# project does not contain, and the dependency modules (core, user,
# common-styling, tests) are not committed. On a fresh clone a full deploy here
# would delete them from the instance, the tests module included.
echo "Deploying to ${env_name}"
pos-cli deploy -p "${env_name}" >/dev/null

# One request per suite. The runner is synchronous and the gateway gives it
# twenty seconds, which the tests that write records go past if they all run
# together. A suite here is just a path prefix; add a line when you add a file
# that writes.
suites=(
  "modules/support"
  "tests/inbound_threading"
  "tests/inbound_reopen"
  "tests/inbound_refusals"
)

echo "Running tests on ${url}"
failed=0
for suite in "${suites[@]}"; do
  body=$(curl -s --max-time 120 "${url}/_tests/run?formatter=text&name=${suite}")
  node -e '
  const d = JSON.parse(require("fs").readFileSync(0, "utf8"));
  for (const t of d.tests) {
    console.log((t.success ? "  ok   " : "  FAIL ") + t.name + "  " + t.assertions);
    if (!t.success) {
      for (const [field, errors] of Object.entries(t.errors)) {
        for (const e of errors) console.log("         " + field + ": " + e);
      }
    }
  }
  console.log(
    "  " + (d.success ? "passed" : "FAILED") + ": " + d.total_assertions +
    " assertions in " + d.total_tests + " files, " + d.duration_ms + "ms"
  );
  process.exit(d.success ? 0 : 1);
' <<<"${body}" || failed=1
done

if [ "${failed}" -ne 0 ]; then
  echo "Failed"
  exit 1
fi
echo "Passed"
